#: decode.c:114
#, c-format
msgid "Resistor is: %g %cOhm, Tolerance %g%%\n"
msgstr "Резистор: %g %cОм, Точность %g%%\n"

#: error.c:20
#, c-format
msgid "Error %d: Invalid number of arguments\n"
msgstr "Ошибка %d: Неверное количество аргументов\n"

#: error.c:23
#, c-format
msgid "Error %d: Invalid flag\n"
msgstr "Ошибка %d: Неверный флаг\n"

#: error.c:26
#, c-format
msgid "Error %d: Memory allocation error\n"
msgstr "Ошибка %d: Ошибка выделения памяти\n"

#: error.c:29
#, c-format
msgid ""
"Error %d: Invalid color entered, use --help to get a list of available "
"colors\n"
msgstr "Ошибка %d: Введен неверный цвет, используйте флаг --help чтобы получить список возможных цветов\n"

#: error.c:32
#, c-format
msgid "Error %d: first argument cannot be \"black\"\n"
msgstr "Ошибка %d: Черный (black) не может быть первым аргументомф\n"

#: error.c:35
#, c-format
msgid "Error %d: Nominal cannot be \"silver\"\n"
msgstr "Ошибка %d: Серебряный (silver) не может быть в номинале\n"

#: error.c:38
#, c-format
msgid "Error %d: Nominal cannot be \"gold\"\n"
msgstr "Ошибка %d: Золотой (gold) не может быть в номинале\n"

#: error.c:41
#, c-format
msgid "Error %d: Tolerance cannot be \"black\"\n"
msgstr "Ошибка %d: Черный (black) не может быть в точности\n"

#: error.c:44
#, c-format
msgid "Error %d: Tolerance cannot be \"orange\"\n"
msgstr "Ошибка %d: Оранжевый (orange) не может быть в точности\n"

#: error.c:47
#, c-format
msgid "Error %d: Tolerance cannot be \"yellow\"\n"
msgstr "Ошибка %d: Желтый (yellow) не может быть в точности\n"

#: error.c:50
#, c-format
msgid "Error %d: Tolerance cannot be \"white\"\n"
msgstr "Ошибка %d: Белый (white) не может быть в точности\n"

#: run.c:19
#, c-format
msgid "Usage: res [FLAG] <color1> <color2> <color3> <color4>\n"
msgstr "Использование: res [FLAG] <color1> <color2> <color3> <color4>\n"

#: run.c:21
#, c-format
msgid "Decode 4-band resistor color codes.\n"
msgstr "Расшифровывает резистор из 4 цветов\n"

#: run.c:23
#, c-format
msgid "Flags:\n"
msgstr "Флаги:\n"

#: run.c:24
#, c-format
msgid ""
"\t--decode <color1> <color2> <color3> <color4>   Decode colors (default)\n"
msgstr "\t--decode <color1> <color2> <color3> <color4> расшифровать цвета\n"

#: run.c:25
#, c-format
msgid "\t--encode soon\n"
msgstr "\t--encode скоро\n"

#: run.c:26
#, c-format
msgid "\t--help                                          Show this help\n"
msgstr "\t--help                                          Вызвать справку\n"

#: run.c:28
#, c-format
msgid "Valid colors:\n"
msgstr "Варианты цветов\n"

#: run.c:39
#, c-format
msgid "Nothing yet\n"
msgstr "Пока ничего\n"
